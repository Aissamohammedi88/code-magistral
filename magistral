("SEC_AWS", r"AKIA[0-9A-Z]{16}", "AWS Key"),
("SEC_GITHUB", r"ghp_[A-Za-z0-9]{36}", "GitHub Token"),
("SEC_OPENAI", r"sk-[A-Za-z0-9]{32,}", "OpenAI Key"),
("SEC_PASS", r"(?:password|pwd)\s*[:=]\s*['\"][^'\"]{6,}['\"]", "Password en dur"),
