("IDOR_001", r"request\.(?:args|form|json)\[['\"](\w*_?id)['\"]\]", "IDOR potentiel", "critical", "CWE-639"),
("SSRF_001", r"requests\.(?:get|post)\(\s*(?:request\.|params\[|args\[)", "SSRF", "critical", "CWE-918"),
("PATH_001", r"open\s*\(\s*.*(?:request\.|params\[|args\[)", "Path Traversal", "critical", "CWE-22"),
]
def analyze(self, code: str, filename: str) -> List[Finding]:
