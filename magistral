@dataclass
class Finding:
rule_id: str
name: str
severity: str
confidence: str
file: str
line: int
message: str
cwe: str = ""
agent: str = ""

class EngineBase:
name = "BaseEngine"
def analyze(self, code: str, filename: str) -> List[Finding]: return []

class Engine1_Compiler(EngineBase):
name = "1. Compilateur"
def analyze(self, code: str, filename: str) -> List[Finding]:
findings = []
if filename.endswith(".py"):
try:
compile(code, filename, 'exec')
except SyntaxError as e:
findings.append(Finding("COMP_PY", "SyntaxError", "critical", "high", filename, e.lineno or 0, f"Syntaxe: {e.msg}", "", self.name))
return findings

class Engine2_PyCompileAST(EngineBase):
name = "2. Python AST"
def analyze(self, code: str, filename: str) -> List[Finding]:
findings = []
try:
tree = ast.parse(code)
for node in ast.walk(tree):
if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):
if node.func.id in ("eval", "exec"):
findings.append(Finding("AST_001", f"{node.func.id}()", "critical", "high", filename, node.lineno, f"Appel {node.func.id} (CWE-95)", "CWE-95", self.name))
if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
if node.func.attr == "run" and any(kw.arg == "shell" and isinstance(kw.value, ast.Constant) and kw.value.value is True for kw in node.keywords):
findings.append(Finding("AST_002", "shell=True", "critical", "high", filename, node.lineno, "subprocess shell=True (CWE-78)", "CWE-78", self.name))
except SyntaxError:
pass
return findings

class Engine3_RuffPylint(EngineBase):
name = "3. Ruff / Pylint"
def analyze(self, code: str, filename: str) -> List[Finding]:
findings = []
for i, line in enumerate(code.split("\n"), 1):
if re.search(r"except\s*:", line):
findings.append(Finding("RUFF_001", "Bare except", "medium", "high", filename, i, "except: trop large (CWE-390)", "CWE-390", self.name))
if len(line) > 120:
findings.append(Finding("RUFF_002", "Ligne longue", "low", "high", filename, i, "Ligne > 120 chars", "", self.name))
return findings

class Engine4_ESLintChippy(EngineBase):
name = "4. Chippy / JS Lint"
def analyze(self, code: str, filename: str) -> List[Finding]:
findings = []
if not filename.endswith((".js", ".ts", ".jsx", ".tsx")): return findings
for i, line in enumerate(code.split("\n"), 1):
if re.search(r"\beval\s*\(", line):
findings.append(Finding("JS_001", "eval()", "critical", "high", filename, i, "eval() JS", "CWE-95", self.name))
if re.search(r"\.innerHTML\s*=", line):
findings.append(Finding("JS_002", "innerHTML", "high", "high", filename, i, "XSS innerHTML", "CWE-79", self.name))
return findings

class Engine5_CodeQL(EngineBase):
name = "5. CodeQL"
def analyze(self, code: str, filename: str) -> List[Finding]:
findings = []
for i, line in enumerate(code.split("\n"), 1):
if re.search(r"(?:execute|cursor\.execute)\s*\(\s*f['\"].*SELECT", line, re.I):
findings.append(Finding("CODEQL_SQL", "SQL Injection", "critical", "high", filename, i, "Requête SQL avec f-string", "CWE-89", self.name))
if re.search(r"yaml\.load\s*\([^,)]+\)", line):
findings.append(Finding("CODEQL_YAML", "YAML unsafe", "high", "high", filename, i, "yaml.load non sécurisé", "CWE-502", self.name))
return findings

class Engine6_SonarQube(EngineBase):
