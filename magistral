for rid, pat, msg, sev, cwe in self.RULES:
for m in re.finditer(pat, code, re.MULTILINE):
line_num = code[:m.start()].count("\n") + 1
findings.append(Finding(rid, msg, sev, "medium", filename, line_num, msg, cwe, self.name))
return findings

