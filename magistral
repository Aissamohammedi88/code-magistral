class FixEngine:
@classmethod
def fix(cls, code: str, filename: str) -> dict:
changes = []
corrected = code

if filename.endswith(".py"):
fixes = [
(r'\beval\s*\(', 'ast.literal_eval(', 'eval() → ast.literal_eval()', 'import ast'),
(r'\bexec\s*\(', 'compile(', 'exec() → compile()', ''),
(r'except\s*:', 'except Exception as e:', 'except: → except Exception', ''),
(r'shell\s*=\s*True', 'shell=False', 'shell=True → False', ''),
(r'pickle\.loads?\s*\(', 'json.loads(', 'pickle → json', 'import json'),
]

for pattern, repl, desc, imp in fixes:
if re.search(pattern, corrected):
corrected = re.sub(pattern, repl, corrected)
changes.append(desc)
if imp and imp not in corrected:
corrected = imp + "\n" + corrected

secrets_pat = re.compile(r'(password|api_key|secret)\s*=\s*[\'"]([^\'"]+)[\'"]', re.I)
if secrets_pat.search(corrected):
corrected = secrets_pat.sub(r'\1 = os.environ.get("\1".upper())', corrected)
changes.append("Secrets → variables d'environnement")
if "import os" not in corrected:
corrected = "import os\n" + corrected

return {"corrected": corrected, "changes": changes, "total": len(changes)}

