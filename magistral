class JudgeAgent:
PRIORS = {"critical": 0.95, "high": 0.75, "medium": 0.5, "low": 0.25}
CONF_ADJ = {"high": 1.0, "medium": 0.85, "low": 0.5}

def _score(self, severity: str, confidence: str) -> float:
return min(1.0, self.PRIORS.get(severity, 0.5) * self.CONF_ADJ.get(confidence, 1.0))

def judge(self, findings: List[Finding]) -> Dict:
valid, rejected = [], []
seen = set()

for f in findings:
fp = f"{f.rule_id}:{f.file}:{f.line}"
if fp in seen: continue
seen.add(fp)

score = self._score(f.severity, f.confidence)

if score > 0.55:
valid.append((f, score))
else:
rejected.append((f, score))

return {
"valid": [dict(asdict(f), score=round(s, 3)) for f, s in valid],
"rejected": [dict(asdict(f), score=round(s, 3)) for f, s in rejected],
"stats": {"total": len(findings), "validated": len(valid), "rejected": len(rejected)}
}

JUDGE = JudgeAgent()

